#!/usr/bin/env zsh

# Option parsing example: https://gist.github.com/webb/ff380b0eee96dafe1c20c2a136d85ef0
# Zsh expansion
# - Modifiers: https://zsh.sourceforge.io/Doc/Release/Expansion.html#modifiers
# - Flags: https://zsh.sourceforge.io/Doc/Release/Expansion.html#Parameter-Expansion-Flags

# `man zshoptions`
# -e     ERR_EXIT
# -u     NO_UNSET
# -o pipefail | PIPE_FAIL
set -eu
set -o PIPE_FAIL
set -o BRACE_CCL
set -o EXTENDED_GLOB
IFS=$'\n\t'

cmdname=$(basename $0)

fail() {
    echo "Error: $*" >&2
    exit 1
}

print_help() {
    # shellcheck disable=SC2086
    cat <<EOF >&2
$cmdname - slugify string/filename

Transforms an input string into something more command-line friendly.
Removes most punctuation, replaces periods and spaces with
hyphens, lowercases all letters by default.

Usage:
    $cmdname [options] source

Options:
  -h, --help                    print help
  -L, --no-lowercase            don't lowercase the output

EOF
    exit 0
}

to_lowercase=1

main() {
    while getopts ":hL-:" opt; do
        case $opt in
        h)
            print_help
            exit
            ;;
        L)
            to_lowercase=0
            ;;
        -) case $OPTARG in
            help) print_help ;;
            no-lowercase) to_lowercase=0 ;;
            *) fail "Unknown long option \"${OPTARG%%=*}\"" ;;
            esac ;;
        :) fail "Short option \"$OPTARG\" missing argument" ;;
        \?)
            fail "Invalid option"
            exit
            ;;
        esac
    done

    shift $((OPTIND - 1))

    if [[ $# -gt 0 ]]; then
        slugify "${(j: :)@}"
    elif [[ ! -t 0 ]]; then
        while IFS= read -r line || [[ -n "$line" ]]; do
            slugify "$line"
        done
    else
        fail "You must provide a filename/string to rename. Run 'slugify -h' for help."
    fi

}

slugify() {
    input="$1"

    # `man zshexpn`, see 'modifiers'
    fname="${input:t:r}"
    fext="${input:e}"
    # `:e` grabs everything after the last dot, including a leading space when the
    # dot is mid-sentence (e.g. "vs. Jiger").  Strip any surrounding whitespace so
    # it doesn't leak into the reconstructed extension.
    # If the captured "extension" starts with a space the dot was mid-sentence
    # (e.g. "vs. Jiger"), not a file-extension separator.  Fold it back into the
    # stem so the dot gets treated like any other character to replace.
    if [[ "$fext" == ' '* ]]; then
        fname="${fname}.${fext# }"
        fext=""
    fi

    # Convert to lowercase, if selected.
    # On by default
    if [[ $to_lowercase -eq 1 ]]; then
        fname="${(L)fname}"
        fext="${(L)fext}"
    fi

    slug_char='-'
    slug_elim='_'
    n_hyphens=${#${fname//[^-]/}}
    n_underscores=${#${fname//[^_]/}}
    if [[ $n_underscores -gt 1 && $n_hyphens -lt $n_underscores ]]; then
        slug_char='_'
        slug_elim='-'
    fi

    slug="${fname//[^[:alnum:][:space:]._-]/}"         # Strip punctuation
    slug="${slug//[[:space:]\.$slug_elim]/$slug_char}" # Spaces to slug char
    slug="${slug//$slug_char##/$slug_char}"            # Deduplicate slug char
    slug="${slug#$slug_char}"                          # Trim leading slug
    slug="${slug%$slug_char}"                          # Trim trailing slug

    # Reconstruct file extension
    if [[ -n "$fext" ]]; then
        fext=".$fext"
    fi

    output="$slug$fext"
    echo "$output"

}

main "$@"
